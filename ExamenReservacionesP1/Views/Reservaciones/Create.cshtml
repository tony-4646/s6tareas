@model ExamenReservacionesP1.Models.ReservacionesModel

@{
    ViewData["Title"] = "Reservación";
}

<h1>Nueva Reservación</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
               <input type="hidden" asp-for="Estado" value="true"/>
            </div>

            <div class="form-group">
                <label asp-for="Cliente_Id" class="control-label">Cliente</label>
                <select asp-for="Cliente_Id" class="form-control" asp-items="ViewBag.Cliente_Id">
                    <option value="">-- Seleccione un cliente --</option>
                </select>
                <span asp-validation-for="Cliente_Id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Evento_Id" class="control-label">Evento</label>
                <select asp-for="Evento_Id" class="form-control" asp-items="ViewBag.Evento_Id">
                    <option value="">-- Seleccione un evento --</option>
                </select>
                <span asp-validation-for="Evento_Id" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Reservar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Volver</a>
</div>
