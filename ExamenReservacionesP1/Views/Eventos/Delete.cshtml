@model ExamenReservacionesP1.Models.EventosModel

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro en eliminar este evento?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Eve_Nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Descripción:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Eve_Descripcion)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Eve_Fecha)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Ubicación:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Eve_Ubicacion)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Evento_Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>
