@model ExamenReservacionesP1.Models.ClientesModel

@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro de eliminar a este cliente?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Nombre)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Apellido:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Apellido)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Correo:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Email)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Teléfono:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Telefono)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Cliente_Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index">Volver</a>
    </form>
</div>
