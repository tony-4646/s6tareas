@model ExamenReservacionesP1.Models.ClientesModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Nombre)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Apellido:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Apellido)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Correo:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Email)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Teléfono:
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cli_Telefono)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-cliente_id="@Model?.Cliente_Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>
